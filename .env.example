DATABASE_URL=postgresql+psycopg://vertex:vertex@localhost:5432/vertex
REDIS_URL=redis://localhost:6379/0
VERTEX_SCHEDULER=1
VERTEX_AUTO_SEED=1

# Optional OpenAI-compatible model. The agent runs without this.
VERTEX_LLM_BASE_URL=https://api.openai.com/v1
VERTEX_LLM_API_KEY=
VERTEX_LLM_MODEL=gpt-4o-mini

# Used by the Next.js server to reach FastAPI.
API_URL=http://127.0.0.1:8000
